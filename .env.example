# Telegram credentials and access control
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_LONG_POLL_TIMEOUT_SECONDS=25

# Optional Gemini API key. The bot uses gemini-3.8-flash.
GEMINI_API_KEY=

# Free-tier market data API keys. Gold spot works without GOLD_API_KEY;
# gold history/OHLC requires a free Gold API key. CoinGecko Demo is free.
COINGECKO_DEMO_API_KEY=
GOLD_API_KEY=

# Local application settings
BOT_DATABASE_PATH=data/trading_bot.sqlite3
BOT_HTTP_TIMEOUT_SECONDS=20
BOT_LOG_LEVEL=info
BOT_MARKET_CHECK_INTERVAL_SECONDS=300
BOT_NEWS_CHECK_INTERVAL_SECONDS=1800
BOT_TIMEZONE=UTC

# Historical backtests only: simulated account and per-fill costs
BACKTEST_STARTING_BALANCE=10000
BACKTEST_FEE_BPS=10
BACKTEST_SLIPPAGE_BPS=5
BACKTEST_RISK_FRACTION=0.01
